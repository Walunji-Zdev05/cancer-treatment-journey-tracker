PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Paste your MongoDB Atlas connection string here (Atlas > Connect > Drivers).
# Replace <password> with your database user's password. NEVER commit .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOURCLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=tikondane
